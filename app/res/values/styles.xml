<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WeightDiary" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:colorAccent">@color/mint</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.WeightDiary.Dialog" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/mint</item>
        <item name="android:statusBarColor">@color/transparent</item>
    </style>

    <style name="GlassCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="SectionLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardSub">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>
</resources>
